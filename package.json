{
  "name": "plane-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for self-hosted Plane (Community Edition) — lets an LLM act as a project manager across Plane workspaces and projects: work items, cycles, modules, states, labels, comments, members, and intake.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "plane-mcp-server": "dist/index.js"
  },
  "scripts": {
    "start": "node --require dotenv/config dist/hono-index.js",
    "dev": "tsx watch --require dotenv/config  src/index.ts",
    "dev:hono": "tsx watch --require dotenv/config src/hono-index.ts",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/hono": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "axios": "^1.7.9",
    "dotenv": "^17.4.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
