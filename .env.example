# Base URL of your self-hosted Plane instance. Do NOT include /api/v1 - it is appended automatically.
PLANE_BASE_URL=https://plane.mycompany.com

# Personal Access Token: Plane > Profile Settings > Personal Access Tokens > Add personal access token
PLANE_API_KEY=plane_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: default workspace slug (from your Plane URL, e.g. "acme" in https://plane.mycompany.com/acme/projects/).
# If set, tools' workspace_slug argument becomes optional and defaults to this value.
PLANE_WORKSPACE_SLUG=acme
